# Copy to your shell environment before running real LLM smoke tests.
# Do not commit real API keys.

# OpenAI-compatible custom provider configs can point api_key_env here.
OPENAI_API_KEY=

# DeepSeek provider default.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# Gemini provider default. If GEMINI_API_KEY is unset, the code can fall back
# to GOOGLE_API_KEY.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Ollama local provider. The API key is optional; local Ollama usually does not
# require bearer auth. Base URL and model should be copied into llm_config.json.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=
